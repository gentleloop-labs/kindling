// Shared build settings. Kept here rather than in the project file so config
// changes review as readable diffs.

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_CONCURRENCY = YES

TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO

MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 16

KINDLING_BUNDLE_PREFIX = dev.aftaab.kindling
KINDLING_APP_GROUP = group.dev.aftaab.kindling

// Automatic signing is used for device archives and App Store Connect uploads.
DEVELOPMENT_TEAM = GVGJLY2H53
CODE_SIGN_STYLE = Automatic

// Supplied locally. An empty ID selects the no-op analytics tracker.
KINDLING_TELEMETRYDECK_APP_ID =

#include? "Local.xcconfig"

CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
