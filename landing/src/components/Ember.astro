---
interface Props {
  variant?: "hero" | "inline" | "dot";
  sparks?: boolean;
  class?: string;
}

const { variant = "inline", sparks = false, class: className = "" } = Astro.props;
---

<span class:list={["ember", `ember--${variant}`, className]} aria-hidden="true">
  <img src="/assets/ember-mascot.webp" alt="" width="400" height="400" loading={variant === "hero" ? "eager" : "lazy"} fetchpriority={variant === "hero" ? "high" : undefined} decoding="async" />
  {sparks && <span class="ember-sparks" aria-hidden="true"><i></i><i></i><i></i></span>}
</span>
