---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ember from "../components/Ember.astro";

const waitlistAction = import.meta.env.PUBLIC_WAITLIST_FORM_ACTION?.trim() ?? "";
const analyticsEndpoint = import.meta.env.PUBLIC_ANALYTICS_ENDPOINT?.trim() ?? "";
const formConfigured = waitlistAction.startsWith("https://");
---

<BaseLayout
  title="Kindling — A small start for the task you're avoiding"
  description="Kindling is an account-free task starter for the moment you know what to do but cannot begin."
>
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">Task initiation, not task management</p>
      <h1>You don't need a fire.<br /><span class="accent">You need a <span class="spark">spark</span>.</span></h1>
      <p class="hero-lede">Kindling is the app you open in the sixty seconds before you'd otherwise give up on starting.</p>
      <div class="hero-actions">
        <a class="button button--primary" href="/try/" data-track="try_clicked">
          Try it now <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="#waitlist">Join the waitlist</a>
      </div>
      <ul class="trust-list" aria-label="Kindling principles">
        <li>No account</li>
        <li>No streaks</li>
        <li>No day planning</li>
      </ul>
    </div>
    <div class="hero-visual">
      <div class="hearth hearth--outer" aria-hidden="true"></div>
      <div class="hearth hearth--inner" aria-hidden="true"></div>
      <Ember variant="hero" sparks />
      <p class="hero-caption">Meet Ember. It waits with you.</p>
    </div>
  </section>

  <section class="manifesto">
    <div class="section-shell manifesto-inner">
      <p data-reveal>
        For the moment when the task is already known, the phone is already in your hand,
        and <strong>starting still feels impossibly far away.</strong>
      </p>
    </div>
  </section>

  <section class="loop section-shell" id="how-it-works" aria-labelledby="loop-title">
    <div class="section-heading">
      <p class="eyebrow">One calm loop</p>
      <h2 id="loop-title">From stuck to started.</h2>
      <p>No setup ritual. No whole-day overhaul. Just enough structure for the next two minutes.</p>
    </div>
    <ol class="beats">
      <li data-reveal>
        <span class="beat-number">01</span>
        <h3>Name the thing</h3>
        <p>Type the task in whatever words arrive. It stays local, and it does not need to sound tidy.</p>
      </li>
      <li data-reveal>
        <span class="beat-number">02</span>
        <h3>Get one foothold</h3>
        <p>Kindling offers a small, concrete first action—offline and without waiting for AI.</p>
      </li>
      <li data-reveal>
        <span class="beat-number">03</span>
        <h3>Stay for two minutes</h3>
        <p>A short timer holds the step with you. Keep going, stop for now, or notice a distraction. All three count.</p>
      </li>
    </ol>
  </section>

  <section class="not-section">
    <div class="section-shell not-grid">
      <div>
        <p class="eyebrow">Deliberately narrow</p>
        <h2>What Kindling is not.</h2>
      </div>
      <div class="not-list">
        <article data-reveal>
          <span aria-hidden="true">×</span>
          <div><h3>Not a planner</h3><p>It will not ask you to organize the rest of today before helping with right now.</p></div>
        </article>
        <article data-reveal>
          <span aria-hidden="true">×</span>
          <div><h3>Not a streak</h3><p>No missed-day warning, score, or mascot disappointment. Coming back is enough.</p></div>
        </article>
        <article data-reveal>
          <span aria-hidden="true">×</span>
          <div><h3>Not treatment</h3><p>Kindling does not diagnose or treat ADHD. It is a small practical tool for beginning a task.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="quote-section section-shell" aria-label="Kindling principle">
    <Ember variant="inline" />
    <blockquote data-reveal>“The goal isn't to finish everything. It's to make starting feel possible.”</blockquote>
  </section>

  <section class="waitlist section-shell" id="waitlist" aria-labelledby="waitlist-title">
    <div>
      <p class="eyebrow">Help shape the first release</p>
      <h2 id="waitlist-title">A quieter way to begin is coming.</h2>
      <p>Join for occasional build notes and an invitation to early testing. No task data, no daily noise.</p>
    </div>
    <form
      class="waitlist-form"
      action={formConfigured ? waitlistAction : undefined}
      method="post"
      data-configured={String(formConfigured)}
      data-analytics-endpoint={analyticsEndpoint}
    >
      <label for="email">Email address</label>
      <div class="form-row">
        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        <button class="button button--primary" type="submit">Join the waitlist</button>
      </div>
      <input type="hidden" name="tag" value="kindling-phase-0" />
      <p class="form-status" role="status"></p>
      <p class="fine-print">Your email is handled by the hosted form provider configured for this site. See <a href="/privacy/">privacy</a>.</p>
    </form>
  </section>

  <script is:inline define:vars={{ analyticsEndpoint }}>
    const EVENT_KEY = "kindling.landing.events.v1";
    const allowedEvents = new Set(["landing_visited", "try_clicked", "waitlist_submitted"]);
    const sessionId = sessionStorage.getItem("kindling_session_id") ?? crypto.randomUUID?.() ?? `session-${Date.now()}`;
    sessionStorage.setItem("kindling_session_id", sessionId);

    function track(name) {
      if (!allowedEvents.has(name)) return;
      const event = { name, at: new Date().toISOString(), session_id: sessionId, properties: {} };
      const current = JSON.parse(localStorage.getItem(EVENT_KEY) ?? "[]");
      localStorage.setItem(EVENT_KEY, JSON.stringify([...current, event].slice(-100)));
      if (analyticsEndpoint) navigator.sendBeacon(analyticsEndpoint, JSON.stringify(event));
    }

    track("landing_visited");
    document.querySelectorAll('[data-track="try_clicked"]').forEach((link) => {
      link.addEventListener("click", () => track("try_clicked"));
    });

    const form = document.querySelector(".waitlist-form");
    form?.addEventListener("submit", (event) => {
      const status = form.querySelector(".form-status");
      if (form.dataset.configured !== "true") {
        event.preventDefault();
        status.textContent = "The waitlist endpoint still needs to be configured before launch.";
        return;
      }
      track("waitlist_submitted");
      status.textContent = "Sending you to the secure signup confirmation…";
    });
  </script>
</BaseLayout>
